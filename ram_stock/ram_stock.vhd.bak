library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity ram_stock is
    port(
        clk      : in  std_logic;
        reset    : in  std_logic;
        we       : in  std_logic;  -- write enable
        address  : in  std_logic_vector(3 downto 0);
        data_in  : in  integer range 0 to 99;
        data_out : out integer range 0 to 99
    );
end ram_stock;

architecture Behavioral of ram_stock is

    type ram_type is array (0 to 15) of integer range 0 to 99;
    signal ram : ram_type := (
        0  => 5,  -- Producto 0
        1  => 3,
        2  => 2,
        3  => 4,
        4  => 6,
        5  => 1,
        6  => 8,
        7  => 3,
        8  => 7,
        9  => 5,
        10 => 9,
        11 => 2,
        12 => 4,
        13 => 6,
        14 => 3,
        15 => 5
    );

    signal data_reg : integer range 0 to 99 := 0;

begin

    process(clk, reset)
    begin
        if reset = '1' then
            -- Reinicia el stock
            ram <= (
                0  => 5,
                1  => 3,
                2  => 2,
                3  => 4,
                4  => 6,
                5  => 1,
                6  => 8,
                7  => 3,
                8  => 7,
                9  => 5,
                10 => 9,
                11 => 2,
                12 => 4,
                13 => 6,
                14 => 3,
                15 => 5
            );
        elsif rising_edge(clk) then
            if we = '1' then
                ram(to_integer(unsigned(address))) <= data_in;
            end if;
            data_reg <= ram(to_integer(unsigned(address)));
        end if;
    end process;

    data_out <= data_reg;

end Behavioral;
